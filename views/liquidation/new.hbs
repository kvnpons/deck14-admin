{{> head}}
{{> nav}}
<main class="container">
  {{> flash}}
  <h1>Record transaction</h1>

  <form method="POST" action="/liquidation" class="form-card" id="txn-form">
    <label>
      <span>Type</span>
      <select name="type" id="type-select">
        {{#each transactionTypes}}
          <option value="{{this}}" {{#if (eq this ../selectedType)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </label>

    <label>
      <span>Amount</span>
      <input type="number" name="amount" min="0.01" step="0.01" required />
    </label>

    <label>
      <span>Description</span>
      <input type="text" name="description" required />
    </label>

    <label>
      <span>Date</span>
      <input type="date" name="occurredAt" />
    </label>

    <label data-show-when="INCOME,EXPENSE">
      <span>Event</span>
      <select name="eventId">
        <option value="">— select event —</option>
        {{#each events}}
          <option value="{{this.id}}" {{#if (eq this.id ../selectedEventId)}}selected{{/if}}>{{this.clientName}} · {{formatDate this.eventDate}} · {{this.status}}</option>
        {{/each}}
      </select>
    </label>

    <label data-show-when="LOAN,PETTY_CASH">
      <span>Employee name</span>
      <input type="text" name="employeeName" />
    </label>

    <div class="form-actions">
      <a class="btn btn-link" href="/liquidation">Cancel</a>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </form>

  <script>
    (function () {
      var sel = document.getElementById('type-select');
      var fields = document.querySelectorAll('[data-show-when]');
      function sync() {
        var val = sel.value;
        fields.forEach(function (f) {
          var allowed = f.getAttribute('data-show-when').split(',');
          f.style.display = allowed.indexOf(val) !== -1 ? '' : 'none';
        });
      }
      sel.addEventListener('change', sync);
      sync();
    })();
  </script>
</main>
{{> footer}}
