{{> head}}
{{> nav}}
<main class="container">
  {{> flash}}
  <h1>Edit menu item</h1>
  <form method="POST" action="/menu/{{item.id}}" class="form-card">
    <label>
      <span>Name</span>
      <input type="text" name="name" value="{{item.name}}" required />
    </label>
    <label>
      <span>Description</span>
      <textarea name="description" rows="2">{{item.description}}</textarea>
    </label>
    <label>
      <span>Price (PHP)</span>
      <input type="number" name="price" min="0" step="0.01" value="{{item.price}}" required />
    </label>
    <label>
      <span>Category</span>
      <select name="category" required>
        {{#each categories}}
          <option value="{{this}}" {{#if (eq this ../item.category)}}selected{{/if}}>{{lookup ../categoryLabels this}}</option>
        {{/each}}
      </select>
    </label>
    <div class="form-actions">
      <a class="btn btn-link" href="/menu">Cancel</a>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </form>
</main>
{{> footer}}
