{{> head}}
{{> nav}}
<main class="container">
  {{> flash}}
  <h1>Schedule event</h1>
  <form method="POST" action="/events" class="form-card">
    <label>
      <span>Client name</span>
      <input type="text" name="clientName" id="clientName" required />
    </label>
    <label>
      <span>Client profile</span>
      <select name="clientId" id="clientId">
        <option value="">— none —</option>
        <option value="__new__">+ Create new client…</option>
        {{#each clients}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}
      </select>
    </label>
    <fieldset id="newClientFields" hidden>
      <legend>New client (named above)</legend>
      <label><span>Email</span><input type="email" name="newClientEmail" /></label>
      <label><span>Phone</span><input type="text" name="newClientPhone" /></label>
      <label><span>Company</span><input type="text" name="newClientCompany" /></label>
    </fieldset>
    <label>
      <span>Event date</span>
      <input type="date" name="eventDate" required />
    </label>
    <label>
      <span>Pax</span>
      <input type="number" name="pax" min="1" required />
    </label>
    <label>
      <span>Bar open time</span>
      <input type="time" name="barOpenTime" required />
    </label>
    <label>
      <span>Ingress time</span>
      <input type="time" name="ingressTime" required />
    </label>
    <label>
      <span>Event address</span>
      <textarea name="venue" rows="2" required></textarea>
    </label>
    <label>
      <span>Contact name</span>
      <input type="text" name="contactName" required />
    </label>
    <label>
      <span>Contact number</span>
      <input type="tel" name="contactPhone" required />
    </label>
    <label>
      <span>Notes</span>
      <textarea name="notes" rows="3"></textarea>
    </label>
    <div class="form-actions">
      <a class="btn btn-link" href="/events">Cancel</a>
      <button type="submit" class="btn btn-primary">Schedule</button>
    </div>
  </form>
</main>
<script>
  (function () {
    var sel = document.getElementById('clientId');
    var name = document.getElementById('clientName');
    var box = document.getElementById('newClientFields');
    sel.addEventListener('change', function () {
      box.hidden = sel.value !== '__new__';
      if (sel.value && sel.value !== '__new__') name.value = sel.options[sel.selectedIndex].text;
    });
  })();
</script>
{{> footer}}
