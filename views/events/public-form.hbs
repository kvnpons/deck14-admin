{{> head}}
<main class="public-shell">
  <div class="public-card">
    <h1>Request a booking</h1>
    <p class="muted">Step 1 — share your event basics. We'll follow up to confirm. This link can only be used once.</p>

    {{> flash}}

    <form method="POST" action="/book/{{token}}" class="form-card">
      <label>
        <span>Your name</span>
        <input type="text" name="clientName" required />
      </label>
      <label>
        <span>Event date</span>
        <input type="date" name="eventDate" required />
      </label>
      <label>
        <span>How many pax are you booking for?</span>
        <input type="number" name="pax" min="1" required />
      </label>
      <label>
        <span>Bar open time</span>
        <input type="time" name="barOpenTime" required />
      </label>
      <label>
        <span>Ingress time</span>
        <input type="time" name="ingressTime" required />
      </label>
      <label>
        <span>Event address</span>
        <textarea name="venue" rows="2" required></textarea>
      </label>
      <label>
        <span>Contact name</span>
        <input type="text" name="contactName" required />
      </label>
      <label>
        <span>Contact number</span>
        <input type="tel" name="contactPhone" required />
      </label>
      <label>
        <span>Anything we should know? (optional)</span>
        <textarea name="notes" rows="3"></textarea>
      </label>
      <button type="submit" class="btn btn-primary">Submit request</button>
    </form>
  </div>
</main>
{{> footer}}
