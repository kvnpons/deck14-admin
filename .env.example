# Server
PORT=3000
NODE_ENV=development

# Database (Railway provides this automatically when you attach Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/d14?schema=public

# Auth — the centralized admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# JWT signing key (use a long random string in production)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Express session (used for flash messages)
SESSION_SECRET=replace-with-another-long-random-string
