generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
  LOAN
  PETTY_CASH
}

enum QuotationKind {
  MAIN
  ADDITIONAL
}

enum MenuCategory {
  COCKTAIL
  COCKTAIL_SHOOTER
  BEER
  HARD_DRINK
  ADDON
}

model Event {
  id            String        @id @default(cuid())
  clientName    String
  eventDate     DateTime
  pax           Int
  barOpenTime   String
  ingressTime   String
  notes         String?
  status        BookingStatus @default(PENDING)
  source        String? // "admin" | "public" | "migration"
  venue         String? // Event address
  contactName   String?
  contactPhone  String?
  eventType     String? // Wedding, Birthday, Debut, Reunion, Others...
  paymentStatus String?
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  menu          EventMenu?
  quotations    Quotation[]
  bookingLink   BookingLink?

  @@index([eventDate])
  @@index([status])
  @@index([clientId])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  events    Event[]
  invoices  Invoice[]

  @@index([name])
}

model Transaction {
  id           String          @id @default(cuid())
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  employeeName String?
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([type])
  @@index([eventId])
  @@index([occurredAt])
}

model MenuItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  category    MenuCategory
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
}

model Invoice {
  id              String        @id @default(cuid())
  // Human-facing serial; assigned by the database only when the invoice is saved.
  serial          Int           @unique @default(autoincrement())
  customerName    String
  customerCompany String?
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  customerAddress String?
  issueDate       DateTime
  notes           String?
  total           Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  items           InvoiceItem[]
  quotation       Quotation?

  @@index([issueDate])
  @@index([clientId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

// A saved menu-builder configuration assigned to a single event.
model EventMenu {
  id             String   @id @default(cuid())
  eventId        String   @unique
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String
  subtitle       String
  cocktailIds    String[]
  shooterIds     String[]
  fontFamily     String
  accentColor    String
  textColor      String
  overlayOpacity Float
  background     Bytes?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Per-event quote. MAIN = base fee + transport + pax + add-ons; ADDITIONAL = add-ons only.
// Fee figures are snapshotted so later rate changes never alter an existing quotation.
model Quotation {
  id           String          @id @default(cuid())
  serial       Int             @unique @default(autoincrement())
  eventId      String
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind         QuotationKind
  distanceKm   Decimal         @default(0) @db.Decimal(8, 2)
  pax          Int             @default(0)
  pricePerPax  Decimal         @default(0) @db.Decimal(10, 2)
  baseFee      Decimal         @default(0) @db.Decimal(12, 2)
  transportFee Decimal         @default(0) @db.Decimal(12, 2)
  paxAmount    Decimal         @default(0) @db.Decimal(12, 2)
  notes        String?
  total        Decimal         @db.Decimal(12, 2)
  // Set once converted; unique so a quotation can only become one invoice.
  invoiceId    String?         @unique
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        QuotationItem[]

  @@index([eventId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2)

  @@index([quotationId])
}

// Single-use link to the public booking form. usedAt is set atomically on submit.
model BookingLink {
  id        String    @id @default(cuid())
  token     String    @unique
  label     String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  eventId   String?   @unique
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
}
